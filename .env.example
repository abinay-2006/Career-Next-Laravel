APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
ASSET_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=career_next
DB_USERNAME=root
DB_PASSWORD=
# Reuse each web worker's database connection. Worth enabling when the database
# is not in the app's own region; see the note in config/database.php.
DB_PERSISTENT=false

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=private
PUBLIC_UPLOAD_DISK=public
PRIVATE_UPLOAD_DISK=private
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

# Backblaze B2 (local testing only)
B2_ENDPOINT=
B2_REGION=
B2_ACCESS_KEY_ID=
B2_SECRET_ACCESS_KEY=
B2_PUBLIC_BUCKET=
B2_PRIVATE_BUCKET=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

FREELLMAPI_BASE_URL=http://127.0.0.1:31415/v1
FREELLMAPI_API_KEY=
FREELLMAPI_COPILOT_ENABLED=false
# Curated Copilot model chain (max 3, tool-calling models only). Leave a slot empty to disable it.
FREELLMAPI_PRIMARY_MODEL=
FREELLMAPI_SECONDARY_MODEL=
FREELLMAPI_TERTIARY_MODEL=
FREELLMAPI_MODEL_FALLBACK_ENABLED=true
FREELLMAPI_MAX_MODEL_ATTEMPTS=3
FREELLMAPI_MODEL_COOLDOWN_DEFAULT_SECONDS=60
FREELLMAPI_MODEL_COOLDOWN_MAX_SECONDS=300
FREELLMAPI_TIMEOUT_SECONDS=9

# Copilot provider: freellmapi for local development; openrouter for production.
AI_PROVIDER=freellmapi
AI_FALLBACK_PROVIDER=navyai
AI_PROVIDER_FALLBACK_ENABLED=false
AI_TOTAL_TIMEOUT_SECONDS=24

# Hosted providers have no model setting: tool-capable models are discovered from each provider's
# live catalogues (OpenRouter GET /models/user, NavyAI GET /models), cached briefly, with a last-known-good copy for catalogue outages.
AI_MODEL_CATALOG_CACHE_SECONDS=600
AI_MODEL_CATALOG_STALE_SECONDS=86400

# OpenRouter production primary. Its user-filtered catalogue applies account preferences and guardrails;
# actual model access is still verified by completion responses.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_ENABLED=false
OPENROUTER_TIMEOUT_SECONDS=9
OPENROUTER_COOLDOWN_DEFAULT_SECONDS=60
OPENROUTER_COOLDOWN_MAX_SECONDS=300

# NavyAI production fallback. NAVYAI_ALLOWED_PLANS lists plans this account holds (e.g. Plus);
# catalogue models with a required_plan outside it are never selected.
NAVYAI_BASE_URL=https://api.navy/v1
NAVYAI_API_KEY=
NAVYAI_ENABLED=false
NAVYAI_ALLOWED_PLANS=
NAVYAI_CHECK_MODEL_AVAILABILITY=true
NAVYAI_TIMEOUT_SECONDS=9
NAVYAI_COOLDOWN_DEFAULT_SECONDS=60
NAVYAI_COOLDOWN_MAX_SECONDS=300
