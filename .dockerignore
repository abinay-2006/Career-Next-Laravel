
# ============================================================
# ENVIRONMENT FILES AND SECRETS
# ============================================================

.env
.env.*
!.env.example

# ============================================================
# GIT AND DEVELOPMENT DEPENDENCIES
# ============================================================

.git
.github
.gitignore

node_modules
vendor

.vscode
.idea
.codex
.cursor
.agents
.zed
.nova

# ============================================================
# LARAVEL LOCAL DATA AND GENERATED FILES
# ============================================================

# Never include local logs, sessions, caches or generated views.
storage/logs/**
storage/framework/**
storage/app/**

# Allow only the public profile-photo directory.
!storage/app/
!storage/app/public/
storage/app/public/**
!storage/app/public/photos/
storage/app/public/photos/**

# Approved profile photos at the root of the photo directory.
!storage/app/public/photos/*.jpg
!storage/app/public/photos/*.jpeg
!storage/app/public/photos/*.png
!storage/app/public/photos/*.webp

# Approved profile photos exactly one directory deep.
!storage/app/public/photos/*/
!storage/app/public/photos/*/*.jpg
!storage/app/public/photos/*/*.jpeg
!storage/app/public/photos/*/*.png
!storage/app/public/photos/*/*.webp

# Never include the public storage symlink.
public/storage

# ============================================================
# LEGACY UPLOAD DIRECTORIES
# ============================================================

# Exclude all legacy upload content by default.
public/upload/**
public/uploads/**

# Allow the photo directories themselves.
!public/upload/
!public/upload/photos/
!public/uploads/
!public/uploads/photos/

# Exclude all photo contents before applying the image allowlist.
public/upload/photos/**
public/uploads/photos/**

# Approved images at the root of public/upload/photos.
!public/upload/photos/*.jpg
!public/upload/photos/*.jpeg
!public/upload/photos/*.png
!public/upload/photos/*.webp

# Approved images at the root of public/uploads/photos.
!public/uploads/photos/*.jpg
!public/uploads/photos/*.jpeg
!public/uploads/photos/*.png
!public/uploads/photos/*.webp

# Allow exactly one nested directory for approved images.
!public/upload/photos/*/
!public/upload/photos/*/*.jpg
!public/upload/photos/*/*.jpeg
!public/upload/photos/*/*.png
!public/upload/photos/*/*.webp

!public/uploads/photos/*/
!public/uploads/photos/*/*.jpg
!public/uploads/photos/*/*.jpeg
!public/uploads/photos/*/*.png
!public/uploads/photos/*/*.webp

# Two explicitly approved legacy public assets.
!public/uploads/470X310_1.jpg
!public/uploads/admin.jpg

