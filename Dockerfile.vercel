# ============================================================
# Career Next - Laravel 13 on Vercel
# PHP 8.3 + Apache
# ============================================================

FROM php:8.3-apache

WORKDIR /var/www/html

# ------------------------------------------------------------
# Install required PHP extensions
# ------------------------------------------------------------

RUN apt-get update && apt-get install -y \
    git \
    unzip \
    curl \
    libzip-dev \
    libicu-dev \
    libpng-dev \
    libjpeg62-turbo-dev \
    libfreetype6-dev \
    libonig-dev \
    libxml2-dev \
    && docker-php-ext-configure gd \
        --with-freetype \
        --with-jpeg \
    && docker-php-ext-install \
        pdo_mysql \
        mbstring \
        bcmath \
        exif \
        pcntl \
        intl \
        zip \
        gd \
    && a2enmod rewrite \
    && rm -rf /var/lib/apt/lists/*


# ------------------------------------------------------------
# Install Composer
# ------------------------------------------------------------

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer


# ------------------------------------------------------------
# Copy Laravel application
# ------------------------------------------------------------

COPY . .


# ------------------------------------------------------------
# Install Laravel dependencies
# ------------------------------------------------------------

RUN composer install \
    --no-dev \
    --no-interaction \
    --prefer-dist \
    --optimize-autoloader \
    --no-progress


# ------------------------------------------------------------
# Configure Apache document root
# Laravel public directory must be the web root
# ------------------------------------------------------------

ENV APACHE_DOCUMENT_ROOT=/var/www/html/public

RUN sed -ri \
    -e 's!/var/www/html!${APACHE_DOCUMENT_ROOT}!g' \
    /etc/apache2/sites-available/000-default.conf \
    /etc/apache2/apache2.conf


# ------------------------------------------------------------
# Laravel writable directories
# ------------------------------------------------------------

RUN mkdir -p \
    storage/framework/cache \
    storage/framework/sessions \
    storage/framework/views \
    storage/logs \
    bootstrap/cache

RUN chown -R www-data:www-data \
    storage \
    bootstrap/cache \
    public


# ------------------------------------------------------------
# Vercel container configuration
# ------------------------------------------------------------

ENV APP_ENV=production
ENV APP_DEBUG=false

# Vercel supplies PORT.
# Apache normally listens on 80, so configure Apache to use PORT.

RUN sed -i \
    's/^Listen 80$/Listen 80/' \
    /etc/apache2/ports.conf

EXPOSE 80

# Apache starts automatically.
CMD ["apache2-foreground"]